{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // DevDogsUGA uses the club's shared preset (renovate/default.json, Q33), the
  // same one DogDays and DogPack extend. What it does: npm, pub, Actions
  // digests and the Supabase CLI pin; one grouped PR a weekend; patch and minor
  // automerge through the merge queue; majors wait for the officer;
  // vulnerability alerts replace Dependabot security updates.
  extends: ["github>DevDogsUGA/DevDogsUGA//renovate/default"],
  // ROLLOUT SWITCH. Renovate is turned on for the whole repository as a
  // deliberate step (Workflow 2 housekeeping, runbook "Renovate"), not by the
  // merge that adds the preset: until then only the club's own packages are
  // managed, exactly as before. THE EXCEPTION IS SECURITY: the preset's
  // vulnerability alerts add their own rules after the one below, so they
  // still open a PR for a vulnerable dependency (the first one, "Update pnpm
  // to v11.11.0 [SECURITY]", opened 90 seconds after the lane merged). That is
  // wanted, since Dependabot security updates are off. To turn the preset on,
  // delete the first rule below (the one that disables everything) and this
  // comment.
  packageRules: [
    {
      matchPackageNames: ["*"],
      enabled: false,
    },
    {
      matchPackageNames: ["/^@devdogsuga\\//", "devdogsuga_sdk"],
      enabled: true,
    },
  ],
}
