{
  // Repo-wide base for Backstage-internal packages that extend it directly
  // (packages/db, packages/env, packages/events, packages/telemetry). The
  // actual compiler options live in packages/config/tsconfig/base.json —
  // that file ships with the published @devdogsuga/config package and can't
  // reach back out to this one, so this repo treats it as the single source
  // of truth and just forwards to it, rather than keeping two copies in
  // sync by hand.
  "extends": "./packages/config/tsconfig/base.json"
}
