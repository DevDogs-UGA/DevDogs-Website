# Copy to .env (gitignored) on the presenting machine. Read only by the Slidev
# dev server (theme/vite/snippets.ts); never sent to the browser.

# Discord webhook for the DogDays (Next.js) channel. Server settings →
# Integrations → Webhooks → New Webhook → Copy Webhook URL.
DISCORD_SNIPPETS_WEBHOOK_WEB=""

# Discord webhook for the DogPack (Flutter) channel.
DISCORD_SNIPPETS_WEBHOOK_MOBILE=""

# `pnpm present` only — see LAYOUTS.md "Presenting across two laptops".

# Password for /presenter/?password=... (Slidev's --remote flag). Only
# whoever has it can drive the deck.
SLIDES_PRESENTER_PASSWORD=""

# Name of the Cloudflare named tunnel (`cloudflared tunnel create <name>`)
# that exposes the presenting laptop's dev server to the two follower
# laptops. Defaults to "devdogs-slides" if unset.
SLIDES_TUNNEL_NAME=""

# Hostname the tunnel is routed to (`cloudflared tunnel route dns`), and the
# host Vite's dev server allow-lists (server.allowedHosts). Defaults to
# "slides.devdogsuga.org" if unset.
SLIDES_TUNNEL_HOSTNAME=""
