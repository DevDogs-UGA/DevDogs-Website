{
  "name": "slides",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/slidev.mjs dev",
    "build": "node scripts/slidev.mjs build",
    "follow": "node scripts/follow.mjs",
    "export:md": "node scripts/export-md.ts",
    "tag-steps": "node scripts/tag-steps.ts",
    "dev:worker": "wrangler dev --var ACCESS_LOCAL_DEV:true",
    "deploy": "node scripts/slidev.mjs build && node scripts/strip-redirects.mjs && wrangler deploy",
    "types:worker": "wrangler types --strict-vars=false worker/worker-configuration.d.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p worker --noEmit",
    "lint": "eslint worker",
    "lint:fix": "eslint worker --fix"
  },
  "dependencies": {
    "@devdogsuga/brand": "workspace:*",
    "@devdogsuga/events": "workspace:*",
    "@slidev/cli": "^53.0.0",
    "@slidev/theme-default": "^0.25.0",
    "jose": "^6.1.0",
    "lz-string": "1.5.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@devdogsuga/config": "workspace:*",
    "@slidev/parser": "^53.0.0",
    "eslint": "catalog:",
    "playwright-chromium": "^1.63.0",
    "typescript": "catalog:",
    "unocss": "^66.10.5",
    "vitest": "catalog:",
    "wrangler": "^4.135.0"
  }
}
