node_modules/
dist/
*.tsbuildinfo
.slidev/
.DS_Store
*.log
.cache/
.wrangler/
.env
.env.*
!.env.example

# The contract-test fixture commits a hand-written stand-in for a
# compiled build (packages/cli-core/test-fixtures/fixture-repo/packages/demo-source/
# dist/index.js) — it is never actually built, and would otherwise be
# silently caught by the blanket dist/ rule above.
!packages/cli-core/test-fixtures/fixture-repo/packages/demo-source/dist/
!packages/cli-core/test-fixtures/fixture-repo/packages/demo-source/dist/index.js

# @devdogsuga/brand: derived by `pnpm codegen` from artwork/ and Phosphor.
packages/brand/src/generated/assets.ts
packages/brand/src/generated/icons.ts
packages/brand/palette.css

# Link to the DevDogsUGA checkout (see scripts/devdogsuga.mjs); local to each machine.
/devdogsuga

# apps/platform (moved from the product repo; its .gitignore lines, rooted here)
.next/
next-env.d.ts
.vinext/
.dev.vars
.dev.vars.*
!.dev.vars.example
*.pem
coverage/
# Design-sync bundle output, regenerated by format:write.
ds-bundle/
# drizzle-kit pull byproducts: a commented-out "initial migration" plus its
# snapshot. Migrations live in DevDogsUGA's supabase/migrations; the sibling
# schema.ts / relations.ts ARE source and stay tracked.
**/drizzle/*_*/
**/schema/generated/*_*/
# packages/email's own .gitignore, plus its preview output.
packages/email/src/generated/
email-previews/
# Brand images derived from @devdogsuga/brand by the platform's `codegen`
# (scripts/brand-images.ts). The email signatures and platform-192 are deployed
# assets regenerated into public/ before `vinext build`; the rest are exports.
apps/platform/public/brand/banners/
apps/platform/public/brand/email/
apps/platform/public/brand/icons/
apps/platform/public/brand/og/
