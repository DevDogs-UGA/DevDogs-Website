{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "meetings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?$",
            "description": "Permanent id, unique across the whole file: a slug for a new meeting, or the old Airtable record id."
          },
          "slug": {
            "type": "string",
            "pattern": "^(\\d{4}-\\d{2}-\\d{2})(?:-[a-z0-9]+(?:-[a-z0-9]+)*)?$",
            "description": "The meeting's URL on the platform and its posters: its Eastern date (YYYY-MM-DD), plus a lowercase descriptor when another meeting shares the date. Unique across the file."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "The heading on the events page and newsletter card."
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "description": "About two sentences, for the events card."
          },
          "kind": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "Build Session",
                  "Study Session",
                  "Interest Meeting",
                  "Social",
                  "Demo Night"
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "The kind of night, or null for a one-off."
          },
          "building": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "DLW",
                  "Driftmier",
                  "Plant Sciences",
                  "Boyd",
                  "MLC",
                  "Science Learning Center",
                  "Science Library",
                  "Poultry Science",
                  "Main Library",
                  "Tate",
                  "Other"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "description": "The room, or \"TBA\" until there is one."
          },
          "startsAt": {
            "type": "string",
            "description": "ISO 8601 instant, e.g. 2026-09-14T22:00:00.000Z (6 PM Eastern)."
          },
          "endsAt": {
            "type": "string",
            "description": "ISO 8601 instant, after startsAt."
          },
          "rsvpUrl": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ],
            "description": "The Involvement Network event page (uga.campuslabs.com)."
          },
          "cancelledAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When it was cancelled; null while it is on."
          },
          "cancellationReason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 160
              },
              {
                "type": "null"
              }
            ],
            "description": "Shown beside the struck-through row. Needs cancelledAt."
          },
          "countsForCredit": {
            "type": "boolean",
            "description": "Whether checking in earns a star and counts toward EL credit."
          },
          "surveyUrl": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ],
            "description": "An outside survey linked after check-in; usually null."
          },
          "questions": {
            "description": "Ids of meeting-scoped questions from questions.json to ask after check-in, in order.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "agenda": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?$",
                  "description": "Permanent id, unique across the whole file. A slug."
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "description": "One schedule row's worth."
                },
                "description": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 280
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Shown in the meeting's detail dialog."
                },
                "project": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The work it recommends, in words (\"DogDays & DogPack\")."
                }
              },
              "required": ["id", "title", "description", "project"],
              "additionalProperties": false
            },
            "description": "The workshops running that night."
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "summary",
          "kind",
          "building",
          "location",
          "startsAt",
          "endsAt",
          "rsvpUrl",
          "cancelledAt",
          "cancellationReason",
          "countsForCredit",
          "surveyUrl",
          "agenda"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["meetings"],
  "additionalProperties": false,
  "title": "DevDogs meetings",
  "description": "The club's meetings and their workshops (Backstage packages/events)."
}
