                "type": "boolean"
              },
              "retired": {
                "description": "Stop asking it, even where listed; answers are kept.",
                "type": "boolean"
              },
              "prefill": {
                "description": "Meeting questions only. last: start from the person's previous answer. Default none.",
                "type": "string",
                "enum": ["last", "none"]
              },
