{
  // Emits for production consumers. The templates are JSX but nothing here
  // ever mounts: Satori consumes the plain {type, props} objects the automatic
  // runtime produces. Templates still import React explicitly as a defensive
  // measure in case a loader picks the classic runtime.
  "extends": "../config/tsconfig/lib.json",
  "compilerOptions": {
    "lib": ["ES2025"],
    "jsx": "react-jsx",
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"],
  // Tests are typechecked (tsconfig.typecheck.json includes them) but never
  // emitted.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
