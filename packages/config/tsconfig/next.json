{
  // Shared preset for the Next apps (platform, schedule-builder).
  //
  // Extended by relative path, not by package specifier — see lib.json.
  // "./base.json" is a sibling shipped in this same package (see
  // package.json's `exports`); a path escaping packages/config would
  // resolve nowhere once installed as a dependency.
  //
  // Only the path-independent settings live here. `paths`, `include`, and
  // `exclude` resolve against the config file that declares them, so hoisting
  // them would rebase "~/*" onto packages/config; they stay in each app.
  "extends": "./base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "plugins": [{ "name": "next" }]
  }
}
