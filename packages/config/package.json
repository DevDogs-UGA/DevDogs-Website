{
  "name": "@devdogsuga/config",
  "version": "0.1.0",
  "description": "Shared tsconfig, ESLint and Vitest presets.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevDogsUGA/Backstage.git",
    "directory": "packages/config"
  },
  "exports": {
    "./eslint": "./eslint/index.js",
    "./eslint/library": "./eslint/library.js",
    "./tsconfig/*": "./tsconfig/*",
    "./vitest/node": {
      "types": "./vitest/node.d.ts",
      "default": "./vitest/node.js"
    },
    "./vitest/react": {
      "types": "./vitest/react.d.ts",
      "default": "./vitest/react.js"
    },
    "./vitest/setup-react": "./vitest/setup-react.js"
  },
  "files": [
    "eslint",
    "tsconfig",
    "vitest"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "eslint": "^9.39.0"
  },
  "dependencies": {
    "@testing-library/jest-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint-config-next": "16.3.2",
    "eslint-plugin-drizzle": "^0.2.3",
    "typescript-eslint": "^8.67.0"
  },
  "devDependencies": {
    "vitest": "catalog:"
  }
}
