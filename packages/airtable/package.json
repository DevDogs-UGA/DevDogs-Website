{
  "name": "@devdogsuga/airtable",
  "version": "0.1.0",
  "description": "The Airtable base treaty: field registry, sync engine, base verifier and officer-change command grammar",
  "license": "MIT",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/devdogsuga/Backstage.git",
    "directory": "packages/airtable"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./officer-change": {
      "types": "./dist/officerChange.d.ts",
      "default": "./dist/officerChange.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema-snapshot.json"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@devdogsuga/config": "workspace:*",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12"
  }
}
