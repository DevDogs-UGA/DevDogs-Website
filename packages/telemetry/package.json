{
  "name": "@devdogsuga/telemetry",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Shared Sentry constants, options builder, scrubbers, and alert() for every service that reports telemetry. Standalone by design — devtools bundles this as a regular dep so error reporting works with no/broken repo.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevDogsUGA/Backstage.git",
    "directory": "packages/telemetry"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "devdogs-source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@sentry/core": "catalog:"
  },
  "devDependencies": {
    "@devdogsuga/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
