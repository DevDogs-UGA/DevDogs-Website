{
  // ESLint's type-aware project, not a build or typecheck config. tsconfig.json
  // leaves tests out, so this adds them back; and the tests import siblings
  // without extensions (vitest resolves them), which NodeNext rejects, hence
  // bundler resolution here. Never emitted.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "tsBuildInfoFile": "./tsconfig.lint.tsbuildinfo"
  },
  "exclude": ["node_modules", "test-fixtures"]
}
