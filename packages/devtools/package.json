{
  "name": "@devdogsuga/devtools",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Contributor CLI for a DevDogsUGA checkout: the real tools with the session's tier filled in, a menu over them, and the checks CI runs. Ships built JS; run via `pnpm dlx @devdogsuga/devtools` (or the `devtools` bin once installed) from inside a DevDogsUGA clone.",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevDogsUGA/Backstage.git",
    "directory": "packages/devtools"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "devtools": "./bin/devtools.mjs"
  },
  "files": [
    "bin",
    "dist",
    "env.ts"
  ],
  "scripts": {
    "build": "tsdown && node scripts/write-build-info.mjs && node ../../scripts/check-bundle-imports.mjs",
    "cli": "node ./bin/devtools.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "@sentry/core": "catalog:",
    "@sentry/node": "catalog:",
    "@supabase/supabase-js": "catalog:",
    "dotenv": "^17.4.2",
    "postgres": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@devdogsuga/db": "*",
    "@devdogsuga/env": "*"
  },
  "peerDependenciesMeta": {
    "@devdogsuga/db": {
      "optional": true
    },
    "@devdogsuga/env": {
      "optional": true
    }
  },
  "devDependencies": {
    "@devdogsuga/cli-core": "workspace:*",
    "@devdogsuga/config": "workspace:*",
    "@devdogsuga/db": "workspace:*",
    "@devdogsuga/env": "workspace:*",
    "@devdogsuga/telemetry": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "tsdown": "^0.23.0",
    "vitest": "catalog:"
  }
}
