{
  // `pnpm typecheck` covers `env.ts` (devtools' own operator manifest) and
  // `vitest.config.ts` too, neither of which `tsconfig.json` can include:
  // anything under `rootDir` is emitted to `dist/`, and `env.ts` sits at the
  // package root deliberately (see its own header) rather than under `src/`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": [
    "src",
    "env.ts",
    "vitest.config.ts",
    "vitest.contract.config.ts",
    "test/contract"
  ],
  // The fixture repo is its own (fake) workspace, deliberately not part of
  // this package's TypeScript project — its files typecheck (or don't)
  // against whatever the real DevDogsUGA workspace would provide, which is
  // not this repo's concern, and its `@devdogsuga/env`/`@devdogsuga/*`
  // imports only resolve once the contract test's `pnpm install` step has
  // run against packed tarballs.
  "exclude": ["src/**/*.test.ts", "test/fixture-repo"]
}
