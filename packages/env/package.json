{
  "name": "@devdogsuga/env",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Env-registry machinery: declare()/define() manifests, target/tier resolution, with-env session loading, and a @t3-oss/env-nextjs re-export. Ships no variables — the registry of actual names and schemas is repo data that stays in the consuming app.",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevDogsUGA/Backstage.git",
    "directory": "packages/env"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./load": {
      "types": "./dist/load.d.ts",
      "default": "./dist/load.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "default": "./dist/session.js"
    },
    "./nextjs": {
      "types": "./dist/nextjs.d.ts",
      "default": "./dist/nextjs.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "@dotenvx/dotenvx": "^2.21.0",
    "@t3-oss/env-core": "^0.13.11",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@yarnpkg/fslib": "^3.1.5",
    "@yarnpkg/shell": "^4.1.3",
    "commander": "^14.0.3",
    "tsx": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@devdogsuga/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "bin": {
    "with-env": "./bin/with-env.mjs"
  }
}
