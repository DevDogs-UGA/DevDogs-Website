# One approval from the reviewers hierarchy is the ordinary merge gate.
* @DevDogsUGA/reviewers

# Workflow and repository-policy changes, the platform, the shared packages and
# CLIs, and the database require DevOps review.
/.github/** @DevDogsUGA/devops
/apps/platform/** @DevDogsUGA/devops
/packages/** @DevDogsUGA/devops
/supabase/** @DevDogsUGA/devops
/scripts/** @DevDogsUGA/devops
/workers.json @DevDogsUGA/devops
/patches/** @DevDogsUGA/devops
/renovate.json5 @DevDogsUGA/devops
/renovate/** @DevDogsUGA/devops
/docs/operations/** @DevDogsUGA/devops

# Hand-written migrations are where destructive and data-moving changes live
# (Q10): the focus leads read them too, and either team can approve.
/supabase/migrations/** @DevDogsUGA/focus-leads @DevDogsUGA/devops

# Only admins own the ownership policy itself. This must stay after the rules
# above because the last matching CODEOWNERS pattern wins.
/.github/CODEOWNERS @DevDogsUGA/admins
